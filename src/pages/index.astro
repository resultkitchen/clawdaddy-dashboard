---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Features from '../components/Features.astro';
import ModelTiers from '../components/ModelTiers.astro';
import Quiz from '../components/Quiz.astro';
import Pricing from '../components/Pricing.astro';

const title = "ClawGrab | Your day, handled.";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">

		<script is:inline>window.__CLAWGRAB_API__ = "https://api.clawgrab.app";</script>

		<!-- FOEC prevention: apply saved language before paint -->
		<script is:inline>
			var lang = localStorage.getItem('clawgrab-lang') || 'en';
			document.documentElement.setAttribute('lang', lang);
			if (lang !== 'en') document.documentElement.classList.add('i18n-loading');
		</script>
		<style>
			.i18n-loading [data-i18n],
			.i18n-loading [data-i18n-placeholder] { opacity: 0; }
		</style>

		<style>
			:root {
				--primary: #6C63FF;
				--primary-light: #EEF0FF;
				--accent: #FF8C42;
				--accent-light: #FFF4EC;
			}
			body {
				background-color: #FAFAFA;
				font-family: 'Inter', system-ui, sans-serif;
			}
		</style>
	</head>
	<body class="text-text-primary selection:bg-primary/20 selection:text-text-primary">
		<Header />

		<main>
			<Hero />
			<Features />
			<ModelTiers />
			<Quiz />
			<Pricing />
		</main>

		<footer class="py-16 bg-white border-t border-border">
			<div class="max-w-7xl mx-auto px-4 sm:px-6 text-center">
				<div class="w-10 h-10 bg-primary rounded-xl flex items-center justify-center mx-auto mb-6">
					<span class="text-white font-bold text-lg">C</span>
				</div>
				<p class="text-text-secondary text-sm mb-4" data-i18n="footer.copy">&copy; 2026 ClawGrab. All rights reserved.</p>
				<div class="flex items-center justify-center gap-6 text-text-secondary text-xs font-medium">
					<a href="#" class="hover:text-text-primary transition-colors" data-i18n="footer.privacy">Privacy</a>
					<a href="#" class="hover:text-text-primary transition-colors" data-i18n="footer.terms">Terms</a>
					<a href="#" class="hover:text-text-primary transition-colors" data-i18n="footer.github">GitHub</a>
				</div>
			</div>
		</footer>
	</body>
</html>
