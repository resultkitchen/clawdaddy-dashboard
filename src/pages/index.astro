---
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ModelTiers from '../components/ModelTiers.astro';
import Quiz from '../components/Quiz.astro';
import Pricing from '../components/Pricing.astro';

const title = "ClawDaddy | Your AI Chief of Staff. In 5 Minutes.";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;900&display=swap" rel="stylesheet">

		<!-- FOEC prevention: apply saved language before paint -->
		<script is:inline>
			var lang = localStorage.getItem('clawdaddy-lang') || 'en';
			document.documentElement.setAttribute('lang', lang);
			if (lang !== 'en') document.documentElement.classList.add('i18n-loading');
		</script>
		<style>
			.i18n-loading [data-i18n],
			.i18n-loading [data-i18n-placeholder] { opacity: 0; }
		</style>

		<style>
			:root {
				--primaryAccent: #F59E0B;
				--bgDark: #0A0A0A;
			}
			body {
				background-color: var(--bgDark);
				font-family: 'Inter', sans-serif;
			}
			.font-black { font-weight: 900; }
		</style>
	</head>
	<body class="text-white selection:bg-[#F59E0B] selection:text-black">
		<Header />

		<main>
			<Hero />
			<ModelTiers />
			<Quiz />
			<Pricing />
		</main>

		<footer class="py-20 bg-[#0F0F0F] border-t border-white/5">
			<div class="max-w-7xl mx-auto px-6 text-center">
				<div class="w-12 h-12 bg-[#F59E0B] rounded-xl flex items-center justify-center mx-auto mb-8 shadow-lg shadow-[#F59E0B]/20">
					<span class="text-black font-black text-2xl">C</span>
				</div>
				<p class="text-zinc-500 text-sm mb-4" data-i18n="footer.copy">© 2026 ClawDaddy. All rights reserved.</p>
				<div class="flex items-center justify-center gap-6 text-zinc-600 text-xs uppercase tracking-widest font-bold">
					<a href="#" class="hover:text-white transition-colors" data-i18n="footer.privacy">Privacy</a>
					<a href="#" class="hover:text-white transition-colors" data-i18n="footer.terms">Terms</a>
					<a href="#" class="hover:text-white transition-colors" data-i18n="footer.github">GitHub</a>
				</div>
			</div>
		</footer>
	</body>
</html>
