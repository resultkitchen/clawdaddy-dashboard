---
const title = "Login | ClawDaddy";
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #0A0A0A; font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="text-white flex items-center justify-center min-h-screen p-6">
    <div class="w-full max-w-md">
        <div class="text-center mb-10">
            <div class="w-16 h-16 bg-[#F59E0B] rounded-2xl flex items-center justify-center mx-auto mb-6 shadow-xl shadow-[#F59E0B]/20">
                <span class="text-black font-black text-3xl">C</span>
            </div>
            <h1 class="text-3xl font-black tracking-tight">COMMAND CENTER</h1>
            <p class="text-zinc-500 mt-2">Access your autonomous workforce.</p>
        </div>

        <div class="bg-[#111] border border-white/5 p-8 rounded-3xl shadow-2xl">
            <div class="space-y-6">
                <div>
                    <label class="block text-xs font-bold uppercase tracking-widest text-zinc-500 mb-2">Member ID or Email</label>
                    <input type="text" id="login-id" class="w-full p-4 bg-white/5 border border-white/10 rounded-xl text-white focus:outline-none focus:border-[#F59E0B]/50 transition-all" placeholder="Enter your ID" />
                </div>
                <button id="login-btn" class="w-full p-4 bg-[#F59E0B] text-black font-bold rounded-xl hover:scale-[1.02] transition-all">
                    Enter Estate
                </button>
            </div>

            <div class="mt-8 pt-8 border-t border-white/5 text-center">
                <p class="text-sm text-zinc-600">Don't have an invite? <a href="/#quiz" class="text-[#F59E0B] font-bold">Get Started</a></p>
            </div>
        </div>
        
        <p class="text-center text-zinc-700 text-[10px] uppercase tracking-[0.2em] mt-8 font-bold">Secure Handshake Protocol v3.1</p>
    </div>

    <script>
        const loginBtn = document.getElementById('login-btn');
        const loginInput = document.getElementById('login-id') as HTMLInputElement;

        loginBtn?.addEventListener('click', () => {
            const id = loginInput.value.trim();
            if (id) {
                // For the demo, we'll just redirect to the dashboard with the ID as a param
                window.location.href = `/dashboard?id=${encodeURIComponent(id)}`;
            } else {
                alert('Please enter your Member ID.');
            }
        });
    </script>
</body>
</html>
