---
const memberId = Astro.url.searchParams.get('id');

// In a real app, we'd fetch the member data from PocketBase here
// const pbUrl = process.env.POCKETBASE_URL;
// const response = await fetch(`${pbUrl}/api/collections/members/records/${memberId}`);
// const member = await response.json();

const title = "Estate Dashboard | ClawDaddy";
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { background-color: #0A0A0A; font-family: 'Inter', sans-serif; }
        .stat-card { background: #111; border: 1px solid rgba(255,255,255,0.05); padding: 1.5rem; rounded: 1.5rem; }
    </style>
</head>
<body class="text-white min-h-screen bg-[#0A0A0A]">
    <nav class="border-b border-white/5 bg-[#0F0F0F] px-6 py-4">
        <div class="max-w-7xl mx-auto flex items-center justify-between">
            <div class="flex items-center gap-2">
                <div class="w-6 h-6 bg-[#F59E0B] rounded flex items-center justify-center">
                    <span class="text-black font-black text-sm">C</span>
                </div>
                <span class="font-bold tracking-tight">CLAW<span class="text-[#F59E0B]">DADDY</span></span>
            </div>
            <div class="flex items-center gap-4">
                <span class="text-xs font-mono text-zinc-500">MEMBER: {memberId || 'GUEST'}</span>
                <div class="w-8 h-8 rounded-full bg-zinc-800 border border-white/10"></div>
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto p-6 md:p-12">
        <header class="mb-12">
            <h1 class="text-4xl font-black tracking-tight mb-2">ESTATE OVERVIEW</h1>
            <p class="text-zinc-500">Your autonomous agents are active across 3 channels.</p>
        </header>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            <div class="stat-card">
                <span class="text-xs font-bold text-zinc-600 uppercase tracking-widest">Active Agents</span>
                <div class="text-3xl font-black mt-2">04</div>
            </div>
            <div class="stat-card">
                <span class="text-xs font-bold text-zinc-600 uppercase tracking-widest">Tasks Resolved</span>
                <div class="text-3xl font-black mt-2">1,284</div>
            </div>
            <div class="stat-card">
                <span class="text-xs font-bold text-[#F59E0B] uppercase tracking-widest">System Status</span>
                <div class="text-3xl font-black mt-2 text-[#10B981]">NOMINAL</div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            <!-- Nylas Integration Card -->
            <div class="stat-card border-[#F59E0B]/20 relative overflow-hidden">
                <div class="absolute top-0 right-0 p-4">
                    <div class="w-2 h-2 bg-[#F59E0B] rounded-full animate-pulse"></div>
                </div>
                <h3 class="text-xl font-bold mb-4">COMMUNICATIONS HUB</h3>
                <p class="text-zinc-400 text-sm mb-8 leading-relaxed">
                    Connect your professional email to allow ClawDaddy to handle high-velocity scheduling and triage.
                </p>
                
                <button id="connect-nylas" class="px-6 py-3 bg-[#F59E0B] text-black font-bold rounded-xl hover:scale-[1.02] transition-all flex items-center gap-3">
                    <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20"><path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path><path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path></svg>
                    Connect Email via Nylas
                </button>
            </div>

            <!-- Fleet Status -->
            <div class="stat-card">
                <h3 class="text-xl font-bold mb-6">FLEET STATUS</h3>
                <div class="space-y-4">
                    <div class="flex items-center justify-between p-3 bg-white/5 rounded-xl border border-white/5">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 bg-blue-500/20 rounded-lg flex items-center justify-center text-blue-500 font-bold">B</div>
                            <span class="text-sm font-bold">The Bezalel</span>
                        </div>
                        <span class="text-[10px] font-bold text-[#10B981] uppercase tracking-widest">Patrolling</span>
                    </div>
                    <div class="flex items-center justify-between p-3 bg-white/5 rounded-xl border border-white/5">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 bg-purple-500/20 rounded-lg flex items-center justify-center text-purple-500 font-bold">S</div>
                            <span class="text-sm font-bold">The Sofer</span>
                        </div>
                        <span class="text-[10px] font-bold text-[#10B981] uppercase tracking-widest">Indexing</span>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <script define:vars={{ memberId }}>
        const connectBtn = document.getElementById('connect-nylas');
        
        // This would come from your backend/env in production
        const NYLAS_CLIENT_ID = 'your_nylas_client_id'; 
        const REDIRECT_URI = window.location.origin + '/auth/nylas/callback';

        connectBtn?.addEventListener('click', () => {
            const authUrl = `https://api.us.nylas.com/v3/connect/auth?client_id=${NYLAS_CLIENT_ID}&redirect_uri=${encodeURIComponent(REDIRECT_URI)}&response_type=code&scope=email.read_only,calendar&state=${memberId || 'anonymous'}`;
            
            // Open in a popup
            const width = 600;
            const height = 700;
            const left = (window.innerWidth / 2) - (width / 2);
            const top = (window.innerHeight / 2) - (height / 2);
            
            window.open(authUrl, 'Nylas Connection', `width=${width},height=${height},top=${top},left=${left}`);
        });

        // Listen for the success message from the callback popup
        window.addEventListener('message', (event) => {
            if (event.data.type === 'NYLAS_CONNECTED') {
                alert('Success! Your email is now connected to the estate.');
                window.location.reload();
            }
        });
    </script>
</body>
</html>
