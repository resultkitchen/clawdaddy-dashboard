---
import LanguageToggle from './LanguageToggle.astro';
const { title = "ClawDaddy" } = Astro.props;
---
<nav class="fixed top-0 left-0 right-0 z-50 border-b border-white/5 bg-[#0A0A0A]/80 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
    <div class="flex items-center gap-2">
      <div class="w-8 h-8 bg-[#F59E0B] rounded-lg flex items-center justify-center">
        <span class="text-black font-black text-xl">C</span>
      </div>
      <span class="text-white font-bold text-xl tracking-tight">{title}</span>
    </div>

    <div class="hidden md:flex items-center gap-6">
      <a href="#features" class="text-zinc-400 hover:text-white transition-colors text-sm font-medium" data-i18n="header.features">Features</a>
      <a href="#pricing" class="text-zinc-400 hover:text-white transition-colors text-sm font-medium" data-i18n="header.pricing">Pricing</a>
      <LanguageToggle />
      <a href="#quiz" class="px-5 py-2.5 rounded-full bg-[#F59E0B] text-black hover:bg-[#F59E0B]/90 transition-all text-sm font-bold" data-i18n="header.cta">Get Your AI Plan</a>
    </div>

    <!-- Mobile: always show toggle + CTA -->
    <div class="flex md:hidden items-center gap-3">
      <LanguageToggle />
      <a href="#quiz" class="px-4 py-2 rounded-full bg-[#F59E0B] text-black text-xs font-bold" data-i18n="header.cta">Get Your AI Plan</a>
    </div>
  </div>
</nav>
