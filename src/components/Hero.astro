---
---
<section class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden">
  <!-- Glow Effect -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-96 bg-[#F59E0B]/10 blur-[120px] rounded-full -z-10"></div>

  <div class="max-w-7xl mx-auto px-6 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#F59E0B]/20 bg-[#F59E0B]/5 text-[#F59E0B] text-xs font-bold tracking-widest uppercase mb-8">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#F59E0B] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-[#F59E0B]"></span>
      </span>
      <span data-i18n="hero.badge">OpenClaw is free — forever</span>
    </div>

    <h1 class="text-6xl md:text-8xl lg:text-9xl font-black text-white tracking-tighter leading-[0.85] mb-8 uppercase">
      <span data-i18n="hero.h1.line1">Your Life.</span><br/>
      <span class="text-transparent bg-clip-text bg-gradient-to-br from-[#F59E0B] to-[#D97706]" data-i18n="hero.h1.line2">On Autopilot.</span>
    </h1>

    <p class="max-w-2xl mx-auto text-lg md:text-xl text-zinc-400 font-light leading-relaxed mb-8" data-i18n="hero.sub">
      OpenClaw went viral for a reason. AI that actually handles your daily grind — email, scheduling, research, busywork — so you get your time back. Free to start. No credit card.
    </p>

    <!-- Social proof -->
    <p class="text-zinc-600 text-sm font-medium mb-12" data-i18n="hero.social">50,000+ people already using OpenClaw</p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#quiz" class="w-full sm:w-auto px-8 py-4 rounded-full bg-[#F59E0B] text-black text-lg font-bold hover:scale-105 transition-transform shadow-[0_0_20px_rgba(245,158,11,0.3)]" data-i18n="hero.cta">
        Get Your Free AI Plan
      </a>
    </div>

    <!-- Mobile Device Mockup Container -->
    <div class="mt-20 relative max-w-[320px] mx-auto group">
      <div class="absolute -inset-10 bg-[#F59E0B]/20 blur-3xl rounded-full opacity-0 group-hover:opacity-100 transition-opacity"></div>
      <div class="relative bg-zinc-900 border-8 border-zinc-800 rounded-[3rem] aspect-[9/19.5] shadow-2xl overflow-hidden">
        <div class="absolute top-0 inset-x-0 h-6 bg-zinc-800 flex justify-center items-end pb-1">
          <div class="w-20 h-4 bg-black rounded-full"></div>
        </div>
        <div class="p-6 pt-10 text-left">
          <div class="w-8 h-8 bg-[#F59E0B] rounded-lg mb-4"></div>
          <div class="h-4 w-32 bg-zinc-800 rounded mb-2"></div>
          <div class="h-4 w-24 bg-zinc-800 rounded mb-8"></div>

          <div class="space-y-3">
            <div class="p-3 bg-zinc-800/50 rounded-xl border border-white/5">
              <div class="h-2 w-16 bg-zinc-700 rounded mb-2"></div>
              <div class="h-2 w-full bg-zinc-600 rounded"></div>
            </div>
            <div class="p-3 bg-[#F59E0B]/10 rounded-xl border border-[#F59E0B]/20">
              <div class="h-2 w-20 bg-[#F59E0B]/50 rounded mb-2"></div>
              <div class="h-2 w-full bg-[#F59E0B]/30 rounded"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
