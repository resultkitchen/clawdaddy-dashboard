---
---
<section class="relative pt-32 pb-20 md:pt-48 md:pb-32 overflow-hidden">
  <!-- Glow Effect -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-4xl h-96 bg-[#F59E0B]/10 blur-[120px] rounded-full -z-10"></div>

  <div class="max-w-7xl mx-auto px-6 text-center">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#F59E0B]/20 bg-[#F59E0B]/5 text-[#F59E0B] text-xs font-bold tracking-widest uppercase mb-8">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#F59E0B] opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-[#F59E0B]"></span>
      </span>
      <span data-i18n="hero.badge">Set up in 60 seconds. No tech skills needed.</span>
    </div>

    <h1 class="text-6xl md:text-8xl lg:text-9xl font-black text-white tracking-tighter leading-[0.85] mb-8 uppercase">
      <span data-i18n="hero.h1.line1">Finally Get To Inbox Zero.</span><br/>
      <span class="text-transparent bg-clip-text bg-gradient-to-br from-[#F59E0B] to-[#D97706]" data-i18n="hero.h1.line2">Without Spending Hours On It.</span>
    </h1>

    <p class="max-w-2xl mx-auto text-lg md:text-xl text-zinc-400 font-light leading-relaxed mb-8" data-i18n="hero.sub">
      Your AI workforce handles your email, writes your social posts in your voice, and never forgets an important detail. Set up in 60 seconds.
    </p>

    <!-- Social proof -->
    <p class="text-zinc-600 text-sm font-medium mb-12" data-i18n="hero.social">50,000+ people already reclaiming their time</p>

    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#quiz" class="w-full sm:w-auto px-8 py-4 rounded-full bg-[#F59E0B] text-black text-lg font-bold hover:scale-105 transition-transform shadow-[0_0_20px_rgba(245,158,11,0.3)]" data-i18n="hero.cta">
        Meet Your AI Workforce
      </a>
    </div>

    <!-- Benefit Highlights -->
    <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
      <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
        <div class="w-10 h-10 bg-[#F59E0B]/10 rounded-xl flex items-center justify-center mx-auto mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#F59E0B]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
        </div>
        <p class="text-zinc-300 text-xs font-medium" data-i18n="hero.benefit1">Clean inbox every morning</p>
      </div>
      <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
        <div class="w-10 h-10 bg-[#F59E0B]/10 rounded-xl flex items-center justify-center mx-auto mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#F59E0B]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" /></svg>
        </div>
        <p class="text-zinc-300 text-xs font-medium" data-i18n="hero.benefit2">Social posts in your voice</p>
      </div>
      <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
        <div class="w-10 h-10 bg-[#F59E0B]/10 rounded-xl flex items-center justify-center mx-auto mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#F59E0B]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
        </div>
        <p class="text-zinc-300 text-xs font-medium" data-i18n="hero.benefit3">Never forget a thing</p>
      </div>
      <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/5">
        <div class="w-10 h-10 bg-[#F59E0B]/10 rounded-xl flex items-center justify-center mx-auto mb-3">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-[#F59E0B]" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
        </div>
        <p class="text-zinc-300 text-xs font-medium" data-i18n="hero.benefit4">Works while you sleep</p>
      </div>
    </div>
  </div>
</section>
