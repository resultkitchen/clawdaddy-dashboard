---
---
<section id="features" class="py-24 bg-[#0A0A0A] border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-6xl font-black text-white tracking-tighter mb-4 uppercase" data-i18n="models.h2">PICK YOUR LEVEL OF FREEDOM.</h2>
      <p class="text-zinc-500 max-w-2xl mx-auto" data-i18n="models.sub">Every plan gives you back hours of your day. The only question is how much of your life you want handled.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">

      <!-- Claw ($29/mo) — The Daily Helper -->
      <div class="relative p-8 rounded-3xl border border-white/10 bg-[#0F0F0F] hover:border-white/20 transition-all">
        <div class="mb-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold tracking-widest uppercase mb-4">
            <span data-i18n="models.claw.badge">The Daily Helper</span>
          </div>
          <h3 class="text-2xl font-bold text-white mb-1" data-i18n="models.claw.title">Claw</h3>
          <div class="flex items-baseline gap-1 mb-3">
            <span class="text-3xl font-black text-white" data-i18n="models.claw.price">$29</span>
            <span class="text-zinc-500 text-sm" data-i18n="models.claw.period">/month</span>
          </div>
          <p class="text-zinc-500 text-sm leading-relaxed" data-i18n="models.claw.desc">One email, one social platform. Finally get your inbox under control and stop stressing about what to post.</p>
        </div>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.claw.f1">Wake up to a clean inbox</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.claw.f2">Social posts written and scheduled for you</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.claw.f3">Important reminders so you never drop the ball</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.claw.f4">Set up in 60 seconds, works immediately</span>
          </li>
        </ul>
      </div>

      <!-- Daddy ($59/mo) — The Personal Assistant -->
      <div class="relative p-8 rounded-3xl border border-[#F59E0B]/30 bg-[#0F0F0F] hover:border-[#F59E0B]/50 transition-all shadow-[0_0_30px_rgba(245,158,11,0.05)] scale-105 z-10">
        <div class="absolute -top-4 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-[#F59E0B] text-black text-[10px] font-black uppercase tracking-widest" data-i18n="models.popular">
          Most Popular
        </div>
        <div class="absolute -inset-[1px] rounded-3xl bg-gradient-to-b from-[#F59E0B]/10 to-transparent -z-10"></div>
        <div class="mb-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F59E0B]/10 border border-[#F59E0B]/20 text-[#F59E0B] text-xs font-bold tracking-widest uppercase mb-4">
            <span data-i18n="models.daddy.badge">The Personal Assistant</span>
          </div>
          <h3 class="text-2xl font-bold text-white mb-1" data-i18n="models.daddy.title">Daddy</h3>
          <div class="flex items-baseline gap-1 mb-3">
            <span class="text-3xl font-black text-white" data-i18n="models.daddy.price">$59</span>
            <span class="text-zinc-500 text-sm" data-i18n="models.daddy.period">/month</span>
          </div>
          <p class="text-zinc-500 text-sm leading-relaxed" data-i18n="models.daddy.desc">Three emails, three social platforms. Your digital workforce, in your pocket. Like having a personal assistant without the $3,000/month price tag.</p>
        </div>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#F59E0B] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.daddy.f1">All your inboxes cleared before breakfast</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#F59E0B] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.daddy.f2">Social content across all your platforms</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#F59E0B] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.daddy.f3">Birthdays, deadlines, follow-ups — all remembered</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#F59E0B] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.daddy.f4">Works 24/7 so you don't have to</span>
          </li>
        </ul>
      </div>

      <!-- Big Daddy ($119/mo) — The Full Team -->
      <div class="relative p-8 rounded-3xl border border-white/10 bg-[#0F0F0F] hover:border-white/20 transition-all">
        <div class="mb-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-bold tracking-widest uppercase mb-4">
            <span data-i18n="models.bigdaddy.badge">The Full Team</span>
          </div>
          <h3 class="text-2xl font-bold text-white mb-1" data-i18n="models.bigdaddy.title">Big Daddy</h3>
          <div class="flex items-baseline gap-1 mb-3">
            <span class="text-3xl font-black text-white" data-i18n="models.bigdaddy.price">$119</span>
            <span class="text-zinc-500 text-sm" data-i18n="models.bigdaddy.period">/month</span>
          </div>
          <p class="text-zinc-500 text-sm leading-relaxed" data-i18n="models.bigdaddy.desc">Unlimited everything. Your whole life, handled. Less than a coffee a day for a full digital team working around the clock.</p>
        </div>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.bigdaddy.f1">Unlimited email accounts, all on autopilot</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.bigdaddy.f2">Every social platform, always posting</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.bigdaddy.f3">Your whole life organized and on track</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.bigdaddy.f4">Priority support — a real human when you need one</span>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>
