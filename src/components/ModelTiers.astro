---
---
<section id="features" class="py-24 bg-[#0A0A0A] border-t border-white/5">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-6xl font-black text-white tracking-tighter mb-4 uppercase" data-i18n="models.h2">ONE STAFF. EVERY ROLE.</h2>
      <p class="text-zinc-500 max-w-2xl mx-auto" data-i18n="models.sub">Your AI workforce handles everything — from running your business to building your digital presence. 24/7, on autopilot.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      <!-- Tier 2: Core - Runs Your Business -->
      <div class="relative p-8 rounded-3xl border border-white/10 bg-[#0F0F0F] hover:border-white/20 transition-all">
        <div class="mb-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 text-xs font-bold tracking-widest uppercase mb-4">
            <span data-i18n="models.t2.badge">Core — Runs Your Business</span>
          </div>
          <h3 class="text-2xl font-bold text-white mb-2" data-i18n="models.t2.title">Your Daily Grind Handler</h3>
          <p class="text-zinc-500 text-sm leading-relaxed" data-i18n="models.t2.desc">Inbox cleared before your coffee's ready. Your AI staff handles the busywork so you can focus on what matters.</p>
        </div>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            <span data-i18n="models.t2.f1">Email triage & draft replies</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            <span data-i18n="models.t2.f2">Social media management</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            <span data-i18n="models.t2.f3">Scheduling & reminders</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            <span data-i18n="models.t2.f4">Busywork automation</span>
          </li>
        </ul>
      </div>

      <!-- SOTA: State-of-the-Art -->
      <div class="relative p-8 rounded-3xl border border-[#F59E0B]/30 bg-[#0F0F0F] hover:border-[#F59E0B]/50 transition-all shadow-[0_0_30px_rgba(245,158,11,0.05)]">
        <div class="absolute -inset-[1px] rounded-3xl bg-gradient-to-b from-[#F59E0B]/10 to-transparent -z-10"></div>
        <div class="mb-6">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F59E0B]/10 border border-[#F59E0B]/20 text-[#F59E0B] text-xs font-bold tracking-widest uppercase mb-4">
            <span data-i18n="models.sota.badge">Dev — Builds Your Presence</span>
          </div>
          <h3 class="text-2xl font-bold text-white mb-2" data-i18n="models.sota.title">Your Deep Thinker</h3>
          <p class="text-zinc-500 text-sm leading-relaxed" data-i18n="models.sota.desc">Builds your website, pitch deck, or business plan. Handles research, strategy, and complex problem solving while you sleep.</p>
        </div>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#F59E0B] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
            <span data-i18n="models.sota.f1">Website & landing page building</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#F59E0B] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
            <span data-i18n="models.sota.f2">Complex problem solving</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#F59E0B] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
            <span data-i18n="models.sota.f3">Strategy & planning</span>
          </li>
          <li class="flex items-center gap-3 text-zinc-300 text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-[#F59E0B] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" /></svg>
            <span data-i18n="models.sota.f4">Content creation & copywriting</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
