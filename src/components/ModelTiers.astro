---
---
<section id="features" class="py-20 bg-bg-page border-t border-border">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-14">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-text-primary tracking-tight mb-4" data-i18n="models.h2">Pick your level of support</h2>
      <p class="text-text-secondary max-w-2xl mx-auto" data-i18n="models.sub">Every plan gives you back hours of your day. The only question is how much you want handled.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-5xl mx-auto">

      <!-- Claw ($29/mo) -->
      <div class="relative p-7 rounded-2xl border border-border bg-white transition-all hover:shadow-md">
        <div class="mb-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-600 text-xs font-semibold tracking-wide mb-3">
            <span data-i18n="models.claw.badge">The daily helper</span>
          </div>
          <h3 class="text-xl font-bold text-text-primary mb-1" data-i18n="models.claw.title">Claw</h3>
          <div class="flex items-baseline gap-1 mb-3">
            <span class="text-3xl font-bold text-text-primary" data-i18n="models.claw.price">$29</span>
            <span class="text-text-secondary text-sm" data-i18n="models.claw.period">/month</span>
          </div>
          <p class="text-text-secondary text-sm leading-relaxed" data-i18n="models.claw.desc">One email, one social platform. Finally get your inbox under control and stop stressing about what to post.</p>
        </div>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.claw.f1">Wake up to a clean inbox</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.claw.f2">Social posts written and scheduled for you</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.claw.f3">Important reminders so you never drop the ball</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.claw.f4">Set up in 60 seconds, works immediately</span>
          </li>
        </ul>
      </div>

      <!-- Daddy ($59/mo) — Most Popular -->
      <div class="relative p-7 rounded-2xl border-2 border-primary bg-white shadow-lg shadow-primary/5 z-10">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-primary text-white text-[10px] font-bold tracking-wide" data-i18n="models.popular">
          Most popular
        </div>
        <div class="mb-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-light border border-primary/20 text-primary text-xs font-semibold tracking-wide mb-3">
            <span data-i18n="models.daddy.badge">The personal assistant</span>
          </div>
          <h3 class="text-xl font-bold text-text-primary mb-1" data-i18n="models.daddy.title">Daddy</h3>
          <div class="flex items-baseline gap-1 mb-3">
            <span class="text-3xl font-bold text-text-primary" data-i18n="models.daddy.price">$59</span>
            <span class="text-text-secondary text-sm" data-i18n="models.daddy.period">/month</span>
          </div>
          <p class="text-text-secondary text-sm leading-relaxed" data-i18n="models.daddy.desc">Three emails, three social platforms. Like having a personal assistant without the $3,000/month price tag.</p>
        </div>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.daddy.f1">All your inboxes cleared before breakfast</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.daddy.f2">Social content across all your platforms</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.daddy.f3">Birthdays, deadlines, follow-ups — all remembered</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.daddy.f4">Works 24/7 so you don't have to</span>
          </li>
        </ul>
      </div>

      <!-- Big Daddy ($119/mo) -->
      <div class="relative p-7 rounded-2xl border border-border bg-white transition-all hover:shadow-md">
        <div class="mb-5">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-50 border border-purple-200 text-purple-600 text-xs font-semibold tracking-wide mb-3">
            <span data-i18n="models.bigdaddy.badge">The full team</span>
          </div>
          <h3 class="text-xl font-bold text-text-primary mb-1" data-i18n="models.bigdaddy.title">Big Daddy</h3>
          <div class="flex items-baseline gap-1 mb-3">
            <span class="text-3xl font-bold text-text-primary" data-i18n="models.bigdaddy.price">$119</span>
            <span class="text-text-secondary text-sm" data-i18n="models.bigdaddy.period">/month</span>
          </div>
          <p class="text-text-secondary text-sm leading-relaxed" data-i18n="models.bigdaddy.desc">Unlimited everything. Your whole life, handled. Less than a coffee a day for a full digital team.</p>
        </div>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.bigdaddy.f1">Unlimited email accounts, all on autopilot</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.bigdaddy.f2">Every social platform, always posting</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.bigdaddy.f3">Your whole life organized and on track</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="models.bigdaddy.f4">Priority support — a real human when you need one</span>
          </li>
        </ul>
      </div>

    </div>
  </div>
</section>
