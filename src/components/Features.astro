---
---
<section class="py-20 bg-white border-t border-border">
  <div class="max-w-7xl mx-auto px-6">
    <div class="text-center mb-16">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-text-primary tracking-tight mb-4" data-i18n="features.h2">Here's what changes</h2>
      <p class="text-text-secondary max-w-2xl mx-auto" data-i18n="features.sub">You stop drowning. You stop forgetting. You stop spending your weekend catching up.</p>
    </div>

    <!-- Feature 1: Email -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center mb-20 max-w-5xl mx-auto">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-600 text-xs font-semibold tracking-wide mb-4">
          <span data-i18n="features.email.badge">Email</span>
        </div>
        <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-text-primary tracking-tight mb-4" data-i18n="features.email.title">Wake up to inbox zero, every single day</h3>
        <p class="text-text-secondary leading-relaxed mb-6" data-i18n="features.email.desc">While you sleep, ClawDaddy reads your email, sorts what matters from what doesn't, drafts replies in your voice, and flags anything that needs your attention.</p>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="features.email.f1">Replies drafted in your tone, not robot-speak</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="features.email.f2">Junk filtered, important stuff surfaced</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="features.email.f3">Follow-ups sent automatically so nothing slips</span>
          </li>
        </ul>
      </div>
      <div class="relative p-6 rounded-2xl bg-bg-page border border-border">
        <div class="space-y-4">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-emerald-50 flex items-center justify-center shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            </div>
            <div>
              <p class="text-text-primary text-sm font-medium" data-i18n="features.email.ex1t">23 emails handled overnight</p>
              <p class="text-text-secondary text-xs" data-i18n="features.email.ex1d">5 replies sent, 12 archived, 6 flagged for you</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-accent-light flex items-center justify-center shrink-0 mt-0.5">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <div>
              <p class="text-text-primary text-sm font-medium" data-i18n="features.email.ex2t">Time saved this week: 4.5 hours</p>
              <p class="text-text-secondary text-xs" data-i18n="features.email.ex2d">That's a whole afternoon back in your life</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 2: Social Media -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center mb-20 max-w-5xl mx-auto">
      <div class="order-2 md:order-1 relative p-6 rounded-2xl bg-bg-page border border-border">
        <div class="space-y-4">
          <div class="p-4 rounded-xl bg-white border border-border">
            <p class="text-text-primary text-sm italic" data-i18n="features.social.ex1">"Just tried the new coffee spot on 5th — the oat milk latte is unreal. If you're in the neighborhood, trust me on this one."</p>
            <p class="text-text-secondary text-xs mt-2" data-i18n="features.social.ex1d">Written by ClawDaddy, sounds like you</p>
          </div>
          <div class="flex items-center gap-3 text-text-secondary text-xs">
            <span class="px-2 py-1 rounded bg-blue-50 text-blue-600 font-medium" data-i18n="features.social.tw">Twitter</span>
            <span class="px-2 py-1 rounded bg-pink-50 text-pink-600 font-medium" data-i18n="features.social.ig">Instagram</span>
            <span class="px-2 py-1 rounded bg-indigo-50 text-indigo-600 font-medium" data-i18n="features.social.li">LinkedIn</span>
          </div>
        </div>
      </div>
      <div class="order-1 md:order-2">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-accent-light border border-accent/20 text-accent text-xs font-semibold tracking-wide mb-4">
          <span data-i18n="features.social.badge">Social media</span>
        </div>
        <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-text-primary tracking-tight mb-4" data-i18n="features.social.title">Your social posts, written in your voice</h3>
        <p class="text-text-secondary leading-relaxed mb-6" data-i18n="features.social.desc">No more staring at a blank screen wondering what to post. ClawDaddy learns how you talk, what you care about, and creates content that sounds like you — not a marketing robot.</p>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="features.social.f1">Content that sounds like you, not a template</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="features.social.f2">Posted at the right time for maximum reach</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="features.social.f3">Stay visible without social media being your job</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Feature 3: Never Forget -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 items-center mb-20 max-w-5xl mx-auto">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-50 border border-purple-200 text-purple-600 text-xs font-semibold tracking-wide mb-4">
          <span data-i18n="features.memory.badge">Memory</span>
        </div>
        <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-text-primary tracking-tight mb-4" data-i18n="features.memory.title">Never forget a birthday, deadline, or detail</h3>
        <p class="text-text-secondary leading-relaxed mb-6" data-i18n="features.memory.desc">ClawDaddy remembers everything so you don't have to. Your mom's birthday, that follow-up you promised, the deadline that's creeping up — it's all tracked.</p>
        <ul class="space-y-3">
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="features.memory.f1">Automatic reminders before things are due</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="features.memory.f2">Follow-ups sent so you never ghost anyone</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-purple-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="features.memory.f3">That feeling of being on top of everything</span>
          </li>
        </ul>
      </div>
      <div class="relative p-6 rounded-2xl bg-bg-page border border-border">
        <div class="space-y-3">
          <div class="flex items-start gap-3 p-3 rounded-xl bg-purple-50 border border-purple-100">
            <div class="w-2 h-2 rounded-full bg-purple-500 mt-1.5 shrink-0"></div>
            <div>
              <p class="text-text-primary text-sm font-medium" data-i18n="features.memory.ex1t">Mom's birthday is tomorrow</p>
              <p class="text-text-secondary text-xs" data-i18n="features.memory.ex1d">Card sent, flowers ordered, reminder set</p>
            </div>
          </div>
          <div class="flex items-start gap-3 p-3 rounded-xl bg-accent-light border border-accent/10">
            <div class="w-2 h-2 rounded-full bg-accent mt-1.5 shrink-0"></div>
            <div>
              <p class="text-text-primary text-sm font-medium" data-i18n="features.memory.ex2t">Project deadline in 3 days</p>
              <p class="text-text-secondary text-xs" data-i18n="features.memory.ex2d">Follow-up sent to your team, status tracked</p>
            </div>
          </div>
          <div class="flex items-start gap-3 p-3 rounded-xl bg-emerald-50 border border-emerald-100">
            <div class="w-2 h-2 rounded-full bg-emerald-500 mt-1.5 shrink-0"></div>
            <div>
              <p class="text-text-primary text-sm font-medium" data-i18n="features.memory.ex3t">Car insurance renewal next week</p>
              <p class="text-text-secondary text-xs" data-i18n="features.memory.ex3d">Comparison quotes pulled, best option flagged</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 4: Works While You Sleep -->
    <div class="text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 border border-blue-200 text-blue-600 text-xs font-semibold tracking-wide mb-4">
        <span data-i18n="features.sleep.badge">24/7</span>
      </div>
      <h3 class="text-xl sm:text-2xl md:text-3xl font-bold text-text-primary tracking-tight mb-4" data-i18n="features.sleep.title">You rest. It works.</h3>
      <p class="text-text-secondary leading-relaxed mb-8" data-i18n="features.sleep.desc">ClawDaddy doesn't take breaks or call in sick. While you're sleeping, having dinner, or just living your life — it's handling the stuff that used to pile up.</p>
      <div class="grid grid-cols-3 gap-4">
        <div class="p-5 rounded-2xl bg-white border border-border shadow-sm">
          <p class="text-2xl font-bold text-primary mb-1" data-i18n="features.sleep.stat1">24/7</p>
          <p class="text-text-secondary text-xs" data-i18n="features.sleep.stat1d">Always working for you</p>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-border shadow-sm">
          <p class="text-2xl font-bold text-primary mb-1" data-i18n="features.sleep.stat2">60s</p>
          <p class="text-text-secondary text-xs" data-i18n="features.sleep.stat2d">To set up, no tech skills</p>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-border shadow-sm">
          <p class="text-2xl font-bold text-primary mb-1" data-i18n="features.sleep.stat3">$0</p>
          <p class="text-text-secondary text-xs" data-i18n="features.sleep.stat3d">Compared to a $3K/mo VA</p>
        </div>
      </div>
    </div>

  </div>
</section>
