---
---
<section id="pricing" class="py-20 bg-white border-t border-border">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-14">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-text-primary tracking-tight mb-4" data-i18n="pricing.h2">Simple plans, real results</h2>
      <p class="text-text-secondary max-w-xl mx-auto" data-i18n="pricing.sub">A personal assistant costs $500-$3,000/month. ClawGrab does the same work, starting at less than $1/day.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">

      <!-- Claw ($29/mo) -->
      <div class="relative p-5 sm:p-7 rounded-2xl border border-border bg-white hover:shadow-md transition-all">
        <div class="mb-6">
          <h3 class="text-xl font-bold text-text-primary mb-2" data-i18n="pricing.claw.name">Claw</h3>
          <p class="text-text-secondary text-sm" data-i18n="pricing.claw.desc">The daily helper. Get your inbox and one social platform under control.</p>
        </div>
        <div class="mb-6 flex items-baseline gap-1">
          <span class="text-4xl font-bold text-text-primary" data-i18n="pricing.claw.price">$29</span>
          <span class="text-text-secondary text-sm" data-i18n="pricing.claw.period">/month</span>
        </div>
        <ul class="mb-8 space-y-3">
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.claw.f1">1 email inbox on autopilot</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.claw.f2">1 social platform managed</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.claw.f3">Reminders and follow-ups</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.claw.f4">Mobile app access</span>
          </li>
        </ul>
        <a href="#quiz" class="block w-full py-3.5 rounded-xl text-center font-bold transition-all bg-bg-page text-text-primary hover:bg-primary-light border border-border" data-i18n="pricing.claw.cta">
          Get started
        </a>
      </div>

      <!-- Daddy ($59/mo) — Most Popular -->
      <div class="relative p-5 sm:p-7 rounded-2xl border-2 border-primary bg-white shadow-lg shadow-primary/5 z-10">
        <div class="absolute -top-3 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-primary text-white text-[10px] font-bold tracking-wide" data-i18n="pricing.popular">
          Most popular
        </div>
        <div class="mb-6">
          <h3 class="text-xl font-bold text-text-primary mb-2" data-i18n="pricing.daddy.name">Daddy</h3>
          <p class="text-text-secondary text-sm" data-i18n="pricing.daddy.desc">The personal assistant. Like hiring help — without the hiring.</p>
        </div>
        <div class="mb-6 flex items-baseline gap-1">
          <span class="text-4xl font-bold text-text-primary" data-i18n="pricing.daddy.price">$59</span>
          <span class="text-text-secondary text-sm" data-i18n="pricing.daddy.period">/month</span>
        </div>
        <ul class="mb-8 space-y-3">
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.daddy.f1">3 email inboxes on autopilot</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.daddy.f2">3 social platforms managed</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.daddy.f3">Remembers everything — birthdays, deadlines, details</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.daddy.f4">Your day planned and ready each morning</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.daddy.f5">English + Spanish</span>
          </li>
        </ul>
        <a href="#quiz" class="block w-full py-3.5 rounded-xl text-center font-bold transition-all bg-primary text-white hover:bg-primary/90" data-i18n="pricing.daddy.cta">
          Get started
        </a>
      </div>

      <!-- Big Daddy ($119/mo) -->
      <div class="relative p-5 sm:p-7 rounded-2xl border border-border bg-white hover:shadow-md transition-all">
        <div class="mb-6">
          <h3 class="text-xl font-bold text-text-primary mb-2" data-i18n="pricing.bigdaddy.name">Big Daddy</h3>
          <p class="text-text-secondary text-sm" data-i18n="pricing.bigdaddy.desc">The full team. Your whole life, handled.</p>
        </div>
        <div class="mb-6 flex items-baseline gap-1">
          <span class="text-4xl font-bold text-text-primary" data-i18n="pricing.bigdaddy.price">$119</span>
          <span class="text-text-secondary text-sm" data-i18n="pricing.bigdaddy.period">/month</span>
        </div>
        <ul class="mb-8 space-y-3">
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.bigdaddy.f1">Unlimited email inboxes</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.bigdaddy.f2">Unlimited social platforms</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.bigdaddy.f3">Everything Daddy does, with no limits</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.bigdaddy.f4">Custom automations for your life</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.bigdaddy.f5">Priority support — a real human when you need one</span>
          </li>
          <li class="flex items-center gap-3 text-text-primary text-sm">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
            <span data-i18n="pricing.bigdaddy.f6">English + Spanish</span>
          </li>
        </ul>
        <a href="#quiz" class="block w-full py-3.5 rounded-xl text-center font-bold transition-all bg-bg-page text-text-primary hover:bg-primary-light border border-border" data-i18n="pricing.bigdaddy.cta">
          Get started
        </a>
      </div>

    </div>
  </div>
</section>
